# LOCAL DEV (running on your own computer): keep this as-is.
VITE_API_URL=http://localhost:4000

# reCAPTCHA v2 SITE key from https://google.com/recaptcha/admin — this
# one is public/safe to expose (it's meant to be visible in the browser).
# The matching SECRET key goes in shaniz-api/.env instead, never here.
# Leave blank in dev; the checkbox area will just show a small notice
# instead of erroring.
VITE_RECAPTCHA_SITE_KEY=

# PRODUCTION (Vercel): set this to an EMPTY string instead —
# VITE_API_URL=
# Leaving it blank makes the site call its own domain for /api requests,
# and vercel.json quietly forwards those to your real backend. This is
# what fixes admin login showing "not signed in" on iPhone/Safari — see
# the comments in vercel.json and SETUP-AND-DEPLOYMENT.md Step 7.
